# =============================================================================
# LearnHouse Production Configuration for bbbacademia.com/courses
# =============================================================================
# This file contains all required environment variables for production.
# NEVER commit this file to version control — it contains secrets.
# Generate all SECRET values using: openssl rand -hex 32

# ─────────────────────────────────────────────────────────────────────────
# Core Deployment Settings
# ─────────────────────────────────────────────────────────────────────────

LEARNHOUSE_TENANCY=single
LEARNHOUSE_DOMAIN=bbbacademia.com
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=bbbacademia.com
NEXT_PUBLIC_LEARNHOUSE_HTTPS=true
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://bbbacademia.com/courses/
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://bbbacademia.com/courses/api/v1/
NEXT_PUBLIC_COLLAB_URL=wss://bbbacademia.com/courses/collab
NEXT_PUBLIC_BASE_PATH=/courses
LEARNHOUSE_COOKIE_DOMAIN=.bbbacademia.com

# ─────────────────────────────────────────────────────────────────────────
# Google reCAPTCHA (bot protection — login/signup/reset/checkout)
# ─────────────────────────────────────────────────────────────────────────
# Public site key — safe to commit, active whenever the two secrets below are
# set. The secrets (RECAPTCHA_SECRET_KEY for the Next.js verify route,
# LEARNHOUSE_RECAPTCHA_SECRET_KEY for the FastAPI checkout endpoint) are
# deliberately NOT set here — they live only in the VPS's persistent
# /root/.learnhouse/bbbacademia-courses/.env (never synced by CI, never
# committed). Without them reCAPTCHA fails OPEN (disabled, not blocking).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcKrKYtAAAAAHJeIiHbDanzcj9Lgjue8b7njYQx

# ─────────────────────────────────────────────────────────────────────────
# NextAuth / Authentication
# ─────────────────────────────────────────────────────────────────────────

NEXTAUTH_URL=https://bbbacademia.com/courses
NEXTAUTH_SECRET=<GENERATE: openssl rand -hex 32>
LEARNHOUSE_AUTH_JWT_SECRET_KEY=<GENERATE: openssl rand -hex 32 (minimum 32 chars)>

# ─────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────

LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:learnhouse@db:5432/learnhouse
DB_PASSWORD=<GENERATE: openssl rand -hex 16>

# ─────────────────────────────────────────────────────────────────────────
# Redis Cache
# ─────────────────────────────────────────────────────────────────────────

LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────────────────────────────────
# Ports & Network
# ─────────────────────────────────────────────────────────────────────────

LEARNHOUSE_PORT=9000
COLLAB_INTERNAL_KEY=<GENERATE: openssl rand -hex 32>

# ─────────────────────────────────────────────────────────────────────────
# Initial Admin Account
# ─────────────────────────────────────────────────────────────────────────
# This is used ONLY on first boot to create the admin. After that, change
# these via the web UI (Settings → Users).

LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@bbbacademia.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=<GENERATE: strong password, save securely>
LEARNHOUSE_INITIAL_ORG_NAME=BBB Academia
LEARNHOUSE_INITIAL_ORG_SLUG=bbb-academia

# ─────────────────────────────────────────────────────────────────────────
# Development Mode (set to False in production)
# ─────────────────────────────────────────────────────────────────────────

LEARNHOUSE_DEVELOPMENT_MODE=False

# ─────────────────────────────────────────────────────────────────────────
# Email Provider (Optional but recommended for signup/password reset)
# ─────────────────────────────────────────────────────────────────────────
# Choose ONE: resend (recommended) or smtp

# Option 1: Resend (simple, reliable)
# Sign up at https://resend.com, get your API key, then uncomment:
# LEARNHOUSE_EMAIL_PROVIDER=resend
# LEARNHOUSE_EMAIL_FROM=noreply@bbbacademia.com
# LEARNHOUSE_EMAIL_RESEND_API_KEY=<your-resend-api-key>

# Option 2: SMTP (your own mail server or service like SendGrid, Mailgun)
# LEARNHOUSE_EMAIL_PROVIDER=smtp
# LEARNHOUSE_SMTP_HOST=smtp.example.com
# LEARNHOUSE_SMTP_PORT=587
# LEARNHOUSE_SMTP_USER=your-email@example.com
# LEARNHOUSE_SMTP_PASSWORD=your-smtp-password
# LEARNHOUSE_SMTP_FROM=noreply@bbbacademia.com

# ─────────────────────────────────────────────────────────────────────────
# File Storage (Optional: Amazon S3 or compatible — Backblaze B2, R2, MinIO)
# ─────────────────────────────────────────────────────────────────────────
# By default, files are stored on-disk (filesystem). For production at scale,
# consider S3-compatible storage. Uncomment and fill in if needed.
# Example below is for Backblaze B2 — get bucketName/endpoint/region and an
# Application Key (keyID + applicationKey) from the B2 console:

# LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
# LEARNHOUSE_S3_API_BUCKET_NAME=<your-b2-bucket-name>
# LEARNHOUSE_S3_API_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
# LEARNHOUSE_S3_API_REGION=<region>
# LEARNHOUSE_S3_API_ACCESS_KEY_ID=<b2-application-key-id>
# LEARNHOUSE_S3_API_SECRET_ACCESS_KEY=<b2-application-key>

# ─────────────────────────────────────────────────────────────────────────
# Optional: AI Features (if desired)
# ─────────────────────────────────────────────────────────────────────────

# LEARNHOUSE_AI_PROVIDER=openai
# LEARNHOUSE_AI_API_KEY=<your-openai-api-key>
# LEARNHOUSE_AI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────
# Optional: Payment Processing (Stripe)
# ─────────────────────────────────────────────────────────────────────────

# LEARNHOUSE_STRIPE_SECRET_KEY=<your-stripe-secret-key>
# LEARNHOUSE_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# ─────────────────────────────────────────────────────────────────────────
# Logging & Observability (Optional)
# ─────────────────────────────────────────────────────────────────────────

LEARNHOUSE_LOGFIRE_ENABLED=False
